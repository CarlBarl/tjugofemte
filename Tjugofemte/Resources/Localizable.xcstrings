{
  "sourceLanguage": "en",
  "strings": {
    "%@ left": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kvar"
          }
        }
      }
    },
    "%@ over": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ över"
          }
        }
      }
    },
    "%@ planned": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ planerat"
          }
        }
      }
    },
    "%lld months": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld månader"
          }
        }
      }
    },
    "1. Create your key": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Skapa din nyckel"
          }
        }
      }
    },
    "2. Register an application at Enable Banking": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Registrera en applikation hos Enable Banking"
          }
        }
      }
    },
    "3. Paste the Application ID": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Klistra in applikations-ID"
          }
        }
      }
    },
    "4. Activate by linking your accounts": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Aktivera genom att länka dina konton"
          }
        }
      }
    },
    "5. Connect your bank": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Anslut din bank"
          }
        }
      }
    },
    "A period runs from one salary to the next. When the salary day falls on a weekend or holiday, the period starts on the banking day before.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En period löper från en lön till nästa. När lönedagen infaller på en helg eller helgdag börjar perioden bankdagen innan."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om appen"
          }
        }
      }
    },
    "Access valid until": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst giltig till"
          }
        }
      }
    },
    "Add budget": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till budget"
          }
        }
      }
    },
    "Add income source": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till inkomst"
          }
        }
      }
    },
    "Add rule": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till regel"
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid"
          }
        }
      }
    },
    "Always put %@ here": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg alltid %@ här"
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belopp"
          }
        }
      }
    },
    "Amount per period": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belopp per period"
          }
        }
      }
    },
    "An RSA key created inside this phone's Keychain. It signs every request to Enable Banking. It never existed as a file, is never backed up, and cannot move to another phone.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En RSA-nyckel som skapats inuti telefonens nyckelring. Den signerar varje anrop till Enable Banking. Den har aldrig funnits som fil, säkerhetskopieras aldrig och kan inte flyttas till en annan telefon."
          }
        }
      }
    },
    "Application ID": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Applikations-ID"
          }
        }
      }
    },
    "Bank": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank"
          }
        }
      }
    },
    "Bank access expires soon": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankåtkomsten går snart ut"
          }
        }
      }
    },
    "Bank access has expired. Reconnect": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankåtkomsten har gått ut. Anslut igen"
          }
        }
      }
    },
    "Bank access lasts up to 180 days. You get a reminder two weeks and three days before it ends.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankåtkomsten gäller i upp till 180 dagar. Du får en påminnelse två veckor och tre dagar innan den går ut."
          }
        }
      }
    },
    "Budget vs actual": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Budget mot utfall"
          }
        }
      }
    },
    "Budgets": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgetar"
          }
        }
      }
    },
    "Budgets, income sources, keyword rules and settings, in the same local database.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgetar, inkomster, nyckelordsregler och inställningar, i samma lokala databas."
          }
        }
      }
    },
