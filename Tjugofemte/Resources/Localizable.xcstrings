    "How is this calculated?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur räknas det här ut?"
          }
        }
      }
    },
    "In the control panel, open your application and choose Activate by linking accounts.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna din applikation i kontrollpanelen och välj Activate by linking accounts."
          }
        }
      }
    },
    "Income": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomst"
          }
        }
      }
    },
    "Income & deposits": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomst och insättningar"
          }
        }
      }
    },
    "Income below plan": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomst under plan"
          }
        }
      }
    },
    "Income came in below plan. Adjusted: %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomsten blev lägre än planerat. Justerat: %@"
          }
        }
      }
    },
    "Income received": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottagen inkomst"
          }
        }
      }
    },
    "Income received minus what you have spent, minus the savings target you already moved.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottagen inkomst minus det du har spenderat, minus sparmålet du redan flyttat."
          }
        }
      }
    },
    "Insurance": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försäkring"
          }
        }
      }
    },
    "Keep history": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara historik"
          }
        }
      }
    },
    "Keyword rules": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelordsregler"
          }
        }
      }
    },
    "Keyword, for example ica": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelord, till exempel ica"
          }
        }
      }
    },
    "Keyword, for example lön": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelord, till exempel lön"
          }
        }
      }
    },
    "Keywords match whole words, ignoring case. Your rules win over the built-in ones, newest first.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelord matchar hela ord oavsett stor eller liten bokstav. Dina regler går före de inbyggda, nyaste först."
          }
        }
      }
    },
    "Leaves this phone": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämnar telefonen"
          }
        }
      }
    },
    "Left over so far": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvar hittills"
          }
        }
      }
    },
    "Link every account you want to see here. Accounts you skip stay invisible to the app.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länka varje konto du vill se här. Konton du hoppar över förblir osynliga för appen."
          }
        }
      }
    },
    "Matches “%@”": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Matchar ”%@”"
          }
        }
      }
    },
    "Move to savings on payday": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta till sparande på lönedagen"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namn"
          }
        }
      }
    },
    "Name it anything, for example Tjugofemte.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Döp den till vad du vill, till exempel Tjugofemte."
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldrig"
          }
        }
      }
    },
    "New income source": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny inkomst"
          }
        }
      }
    },
    "New rule": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny regel"
          }
        }
      }
    },
    "No analytics, no crash reporting kit, no third-party code that phones home.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen analys, inget kraschrapporteringsverktyg, ingen tredjepartskod som ringer hem."
          }
        }
      }
    },
    "No banks loaded yet. Pull to retry.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga banker laddade än. Dra för att försöka igen."
          }
        }
      }
    },
    "No budgets yet. Add them under Plan.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga budgetar än. Lägg till dem under Plan."
          }
        }
      }
    },
    "No copies": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga kopior"
          }
        }
      }
    },
    "No tracking": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen spårning"
          }
        }
      }
    },
    "No transactions in this period": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga transaktioner i den här perioden"
          }
        }
      }
    },
    "Nobody but you can read your transactions. Not the author of this app, not Apple, not Enable Banking beyond the relay.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen utom du kan läsa dina transaktioner. Inte appens upphovsperson, inte Apple, inte Enable Banking utöver själva förmedlingen."
          }
        }
      }
    },
    "None yet. Categorize a transaction and switch on “Always” to create one.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga än. Kategorisera en transaktion och slå på ”Alltid” för att skapa en."
          }
        }
      }
    },
    "Not received": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte mottagen"
          }
        }
      }
    },
    "Nowhere else": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen annanstans"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Older transactions are removed automatically. Delete everything closes the bank connection and wipes the key, the settings and every transaction from this phone.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Äldre transaktioner tas bort automatiskt. Radera allt stänger bankkopplingen och tar bort nyckeln, inställningarna och alla transaktioner från telefonen."
          }
        }
      }
    },
    "On this phone": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På den här telefonen"
          }
        }
      }
    },
    "One button closes the bank connection, deletes the key, the settings and every transaction, and overwrites the deleted database pages.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En knapp stänger bankkopplingen, raderar nyckeln, inställningarna och alla transaktioner och skriver över de raderade databassidorna."
          }
        }
      }
    },
    "Open Tjugofemte and reconnect your bank within %lld days to keep seeing new transactions.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Tjugofemte och anslut banken igen inom %lld dagar för att fortsätta se nya transaktioner."
          }
        }
      }
    },
    "Open the Enable Banking control panel": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Enable Bankings kontrollpanel"
          }
        }
      }
    },
    "Other income": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övrig inkomst"
          }
        }
      }
    },
    "Overview": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Översikt"
          }
        }
      }
    },
    "Paid quarterly": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalas kvartalsvis"
          }
        }
      }
    },
    "Partner, rent share": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambo, del av hyran"
