    },
    "Log in with BankID and approve every account you want to see. Skipped accounts stay invisible to the app.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in med BankID och godkänn varje konto du vill se. Konton du hoppar över förblir osynliga för appen."
          }
        }
      }
    },
