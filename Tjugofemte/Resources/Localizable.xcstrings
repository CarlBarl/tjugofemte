      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj bank"
          }
        }
      }
    },
    "Choose Sweden, your bank, and personal. Tap Link.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Sweden, din bank och personal. Tryck på Link."
          }
        }
      }
    },
    "Closes the bank connection and wipes the key, the plan and every transaction from this phone.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stänger bankkopplingen och raderar nyckeln, planen och varje transaktion från den här telefonen."
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut"
          }
        }
      }
    },
