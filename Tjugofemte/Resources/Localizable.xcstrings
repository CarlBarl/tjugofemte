      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnummer"
          }
        }
      }
    },
    "Pick the account your salary lands on. Transfers to your other linked accounts are recognized automatically.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj kontot som lönen kommer in på. Överföringar till dina andra länkade konton känns igen automatiskt."
          }
        }
      }
    },
    "Plan": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan"
          }
        }
      }
    },
    "Plan only, not matched to transactions": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara plan, matchas inte mot transaktioner"
          }
        }
      }
    },
    "Planned income": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planerad inkomst"
          }
        }
      }
    },
    "Planned income minus every budget below. This is the amount to move on payday.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planerad inkomst minus alla budgetar nedan. Det här är beloppet att flytta på lönedagen."
          }
        }
      }
    },
    "Privacy policy": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Integritetspolicy"
          }
        }
      }
    },
    "Privacy policy and terms URLs: paste these two.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länkar till integritetspolicy och villkor: klistra in dessa två."
          }
        }
      }
    },
    "Quarterly costs": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvartalskostnader"
          }
        }
      }
    },
    "Quarterly costs are spread as a third per period.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvartalskostnader fördelas som en tredjedel per period."
          }
        }
      }
    },
    "Reconnect or change bank": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut igen eller byt bank"
          }
        }
      }
    },
    "Redirect URL: paste the address below.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redirect URL: klistra in adressen nedan."
          }
        }
      }
