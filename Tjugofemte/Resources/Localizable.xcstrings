    "Amount per period": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Belopp per period"
          }
        }
      }
    },
    "An RSA key created inside this phone's Keychain. It signs every request to Enable Banking. It never existed as a file, is never backed up, and cannot move to another phone.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En RSA-nyckel som skapats inuti telefonens nyckelring. Den signerar varje anrop till Enable Banking. Den har aldrig funnits som fil, säkerhetskopieras aldrig och kan inte flyttas till en annan telefon."
          }
        }
      }
    },
    "Application ID": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Applikations-ID"
          }
        }
      }
    },
