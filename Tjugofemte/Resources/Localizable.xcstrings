    "Data protection email": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data protection email"
          }
        }
      }
    },
    "Date, amount, currency, counterparty text and category. Nothing else from the bank's response is kept. Stored in an encrypted SQLite database protected by iOS Data Protection, excluded from iCloud and computer backups, and trimmed to the history length you choose.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum, belopp, valuta, motpartstext och kategori. Inget annat ur bankens svar sparas. Lagras i en krypterad SQLite-databas skyddad av iOS Data Protection, undantagen från iCloud- och datorsäkerhetskopior och rensad till den historik du väljer."
          }
        }
      }
    },
    "Delete everything": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera allt"
          }
        }
      }
    },
    "Delete everything?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera allt?"
          }
        }
      }
    },
    "Deposits whose text contains the keyword count as this income. Leave empty for income that never reaches this account.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Insättningar vars text innehåller nyckelordet räknas som den här inkomsten. Lämna tomt för inkomst som aldrig når det här kontot."
          }
        }
      }
    },
