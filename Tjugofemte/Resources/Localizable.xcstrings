    "A period runs from one salary to the next. When the salary day falls on a weekend or holiday, the period starts on the banking day before.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En period löper från en lön till nästa. När lönedagen infaller på en helg eller helgdag börjar perioden bankdagen innan."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om appen"
          }
        }
      }
    },
    "Access valid until": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst giltig till"
          }
        }
      }
    },
