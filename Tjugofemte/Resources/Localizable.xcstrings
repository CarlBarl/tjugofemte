      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut din bank"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt"
          }
        }
      }
    },
    "Continue setup": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt"
          }
        }
      }
    },
    "Create key": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa nyckel"
          }
        }
      }
    },
    "Creates a keyword rule you can edit under Settings.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapar en nyckelordsregel som du kan ändra under Inställningar."
          }
        }
      }
    },
    "Data protection email": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data protection email"
          }
        }
      }
    },
    "Date, amount, currency, counterparty text and category. Nothing else from the bank's response is kept. Stored in an encrypted SQLite database protected by iOS Data Protection, excluded from iCloud and computer backups, and trimmed to the history length you choose.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum, belopp, valuta, motpartstext och kategori. Inget annat ur bankens svar sparas. Lagras i en krypterad SQLite-databas skyddad av iOS Data Protection, undantagen från iCloud- och datorsäkerhetskopior och rensad till den historik du väljer."
          }
        }
      }
    },
    "Delete everything": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera allt"
          }
        }
      }
    },
    "Delete everything with one tap. Export a CSV first if you like.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera allt med ett tryck. Exportera en CSV först om du vill."
          }
        }
      }
    },
    "Delete everything?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera allt?"
          }
        }
      }
    },
    "Deposits whose text contains it count as this income. Leave empty for income that never reaches this account.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Insättningar vars text innehåller ordet räknas som den här inkomsten. Lämna tomt för inkomst som aldrig når det här kontot."
          }
        }
      }
    },
    "Description": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Description"
          }
        }
      }
    },
