      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj bank"
          }
        }
      }
    },
    "Choose to provide your own public key and paste the key from step 1.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj att ange en egen publik nyckel och klistra in nyckeln från steg 1."
          }
        }
      }
    },
    "Connect your bank": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut din bank"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt"
          }
        }
      }
    },
    "Copy privacy URL": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera integritetslänk"
          }
        }
      }
    },
    "Copy public key": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera publik nyckel"
          }
        }
      }
