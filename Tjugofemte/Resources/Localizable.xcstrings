            "value": "Lön"
          }
        }
      }
    },
    "Salary day": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lönedag"
          }
        }
      }
    },
    "Salary, a partner's share of the rent, CSN. A keyword lets the app match the real deposit against the plan.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lön, en sambos del av hyran, CSN. Med ett nyckelord kan appen matcha den riktiga insättningen mot planen."
          }
        }
      }
    },
    "Sample data": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exempeldata"
          }
        }
