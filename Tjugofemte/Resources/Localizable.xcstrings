        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälsa"
          }
        }
      }
    },
    "History says %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Historiken säger %@"
          }
        }
      }
    },
    "Honest limits": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ärliga begränsningar"
          }
        }
      }
    },
    "How is this calculated?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur räknas det här ut?"
          }
        }
      }
    },
    "How much to move to savings, worked out from your own bank data. It never leaves your phone.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur mycket du ska flytta till sparande, uträknat från din egen bankdata. Den lämnar aldrig telefonen."
          }
        }
      }
    },
    "If you prefer a computer: share the public key to it from the previous step, do this step there, and come back here for step 3.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du hellre använder en dator: dela den publika nyckeln dit från förra steget, gör det här steget där och kom tillbaka hit för steg 3."
          }
        }
      }
    },
    "Included": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Medräknad"
          }
        }
      }
    },
    "Income": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomst"
          }
        }
      }
    },
    "Income & deposits": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomst och insättningar"
          }
        }
      }
    },
    "Income and budgets per salary period, not per calendar month.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomst och budgetar per löneperiod, inte per kalendermånad."
          }
        }
      }
    },
    "Income below plan": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomst under plan"
          }
        }
      }
    },
    "Income came in below plan, so the target is lowered from %@.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomsten blev lägre än planerat, så målet sänks från %@."
          }
        }
      }
    },
    "Income received": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottagen inkomst"
          }
        }
      }
    },
    "Income received minus what you have spent, minus the savings target you move on payday. Negative means the month is running ahead of the plan.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mottagen inkomst minus det du har spenderat, minus sparmålet du flyttar på lönedagen. Minus betyder att månaden ligger före planen."
          }
        }
      }
    },
    "Insurance": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försäkring"
          }
        }
      }
    },
