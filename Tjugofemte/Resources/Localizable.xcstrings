            "value": "Starta min budget"
          }
        }
      }
    },
    "Starts in %lld days": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börjar om %lld dagar"
          }
        }
      }
    },
    "Step %lld of %lld": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg %lld av %lld"
          }
        }
      }
    },
    "Step 1 of 4": {
      "localizations": {
        "sv": {
          "stringUnit": {
