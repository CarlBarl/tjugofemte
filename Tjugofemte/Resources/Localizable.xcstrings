            "value": "Steg 1 av 4"
          }
        }
      }
    },
    "Step 2 of 4": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg 2 av 4"
          }
        }
      }
    },
    "Step 3 of 4": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg 3 av 4"
          }
        }
      }
    },
    "Step 4 of 4": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Steg 4 av 4"
          }
        }
      }
    },
    "Streaming": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming"
          }
        }
      }
    },
    "Student loan (CSN)": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Studielån (CSN)"
          }
        }
      }
    },
    "Subscriptions": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationer"
          }
        }
      }
    },
    "Suggest from history": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreslå från historiken"
          }
        }
      }
    },
    "Switching keeps the plan and refetches history for the chosen account.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byte behåller planen och hämtar historiken för det valda kontot på nytt."
          }
        }
      }
    },
    "Takeaway & restaurants": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtmat och restaurang"
          }
        }
      }
    },
    "Tap Register": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Register"
          }
        }
      }
    },
    "Terms of service URL": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of service URL"
          }
        }
      }
    },
    "The app contains no other network code. iOS App Privacy Report shows every domain it has contacted; try it.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen innehåller ingen annan nätverkskod. iOS Appintegritetsrapport visar varje domän den har kontaktat. Prova."
          }
        }
      }
    },
    "The application should now say Active and Restricted. That is correct.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Applikationen ska nu visa Active och Restricted. Det är rätt."
          }
        }
      }
    },
    "The bank is rate limiting requests. Try again in a few hours.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Banken begränsar antalet anrop. Försök igen om några timmar."
          }
        }
      }
    },
    "The budgets add up to more than the income. Lower a budget, add income, or start anyway and adjust under Plan.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgetarna är större än inkomsten. Sänk en budget, lägg till inkomst, eller starta ändå och justera under Plan."
          }
        }
      }
    },
    "The Enable Banking session id and your Application ID, in the Keychain, device only.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Bankings sessions-id och ditt applikations-ID, i nyckelringen, bara på den här enheten."
          }
        }
      }
    },
    "The form, top to bottom": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Formuläret, uppifrån och ned"
          }
        }
      }
    },
    "The login response did not match this app's request. Try again.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningssvaret matchade inte appens begäran. Försök igen."
          }
        }
      }
    },
    "The private half never leaves the phone and cannot be exported. The public half is what you hand to Enable Banking in the next step. Sharing it is safe.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den privata halvan lämnar aldrig telefonen och kan inte exporteras. Den publika halvan är det du lämnar till Enable Banking i nästa steg. Den är ofarlig att dela."
          }
        }
      }
    },
    "The private key is protected by the Keychain and your passcode, not by the Secure Enclave, because Enable Banking requires RSA. Enable Banking can see which accounts you access and when. The source code is public so all of this can be checked.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den privata nyckeln skyddas av nyckelringen och din lösenkod, inte av Secure Enclave, eftersom Enable Banking kräver RSA. Enable Banking kan se vilka konton du hämtar och när. Källkoden är öppen så att allt detta kan kontrolleras."
          }
        }
      }
    },
    "The sample covers the last three periods.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplet täcker de senaste tre perioderna."
          }
        }
      }
    },
    "The savings number is fixed when a period starts. Spend less than a budget and the difference is yours on top.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparsiffran låses när en period börjar. Spenderar du mindre än en budget är skillnaden din på köpet."
          }
        }
      }
    },
    "Then": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan"
          }
        }
      }
    },
    "This bank needs it to start BankID. It is sent once and never stored.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Banken behöver det för att starta BankID. Det skickas en gång och sparas aldrig."
          }
        }
      }
    },
    "This is what makes the free personal mode work: Enable Banking only ever returns the accounts you link here.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är det som får det kostnadsfria personliga läget att fungera: Enable Banking lämnar bara ut de konton du länkar här."
          }
        }
      }
    },
    "This period": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här perioden"
          }
        }
      }
    },
    "This period started": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här perioden började"
          }
        }
      }
    },
    "This removes your real bank data too, not only the sample. It cannot be undone. Your Enable Banking application stays in their control panel; delete it there too if you are done.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar även bort din riktiga bankdata, inte bara exempeldatan. Det går inte att ångra. Din applikation hos Enable Banking finns kvar i deras kontrollpanel. Radera den där också om du är klar."
          }
        }
      }
    },
    "Three periods of made-up Swedish transactions. Your real data is untouched.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre perioder av påhittade svenska transaktioner. Din riktiga data rörs inte."
          }
        }
      }
    },
    "Tjugofemte": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjugofemte"
          }
        }
      }
    },
    "Tjugofemte is a budgeting app with no company behind the data. There is no server, no account, no analytics, no advertising kit. Your bank history is downloaded by your phone, from your bank, through a connection you own.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjugofemte är en budgetapp utan något företag bakom datan. Det finns ingen server, inget konto, ingen analys, inget annonsverktyg. Din bankhistorik hämtas av din telefon, från din bank, genom en koppling du själv äger."
          }
        }
      }
    },
    "Tjugofemte never sees your bank data. Your phone creates a key, you register it at Enable Banking yourself, and the phone talks to the bank directly. About ten minutes, once.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjugofemte ser aldrig din bankdata. Telefonen skapar en nyckel, du registrerar den själv hos Enable Banking och telefonen pratar direkt med banken. Ungefär tio minuter, en gång."
          }
        }
      }
    },
    "To api.enablebanking.com": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till api.enablebanking.com"
          }
        }
      }
    },
    "To your bank and BankID": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till din bank och BankID"
          }
        }
      }
    },
    "Total": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Summa"
          }
        }
      }
    },
    "Transactions": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktioner"
          }
        }
      }
    },
    "Transfer, own accounts": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Överföring, egna konton"
          }
        }
      }
    },
    "Transport": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport"
          }
        }
      }
    },
    "Try with sample data": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova med exempeldata"
          }
        }
      }
    },
    "Unexpected response from Enable Banking: %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oväntat svar från Enable Banking: %@"
          }
        }
      }
    },
    "Use another Application ID": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ett annat applikations-ID"
          }
        }
      }
    },
    "Usually %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukar vara %@"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "What comes in each period. Add every source you want to plan with.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som kommer in varje period. Lägg till varje källa du vill planera med."
          }
        }
      }
    },
    "When is payday?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När är lönedagen?"
          }
        }
      }
    },
    "When it falls on a weekend or holiday, the period starts on the banking day before.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När den infaller på en helg eller helgdag börjar perioden bankdagen innan."
          }
        }
      }
    },
    "When payday is a weekend or holiday, the period starts on the banking day before.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När lönedagen är en helg eller helgdag börjar perioden bankdagen innan."
          }
        }
      }
    },
    "When you connect, the system browser opens Enable Banking's login page, your bank's page and BankID. That is the same as logging in to your bank yourself.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ansluter öppnar systemets webbläsare Enable Bankings inloggningssida, din banks sida och BankID. Det är samma sak som att logga in på banken själv."
          }
        }
      }
    },
    "Which account?": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilket konto?"
          }
        }
      }
    },
    "Which words put a transaction in which category.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilka ord som lägger en transaktion i vilken kategori."
          }
        }
      }
    },
    "With Swedbank and the savings banks, this bank login sometimes never loads on a phone. If it spins for more than 20 seconds, finish this one step on a computer at enablebanking.com/cp. Everything else stays on the phone.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Swedbank och sparbankerna laddar den här bankinloggningen ibland aldrig på en telefon. Om den snurrar i mer än 20 sekunder, gör klart just det här steget på en dator på enablebanking.com/cp. Allt annat stannar på telefonen."
          }
        }
      }
    },
    "You register the connection yourself. No company sits in between.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du registrerar kopplingen själv. Inget företag sitter emellan."
          }
        }
      }
    },
    "Your bank, your key": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din bank, din nyckel"
          }
        }
      }
    },
    "Your budget runs from one payday to the next, and the savings number is for that day.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din budget löper från en lönedag till nästa, och sparsiffran gäller den dagen."
          }
        }
      }
    },
    "Your budgets": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina budgetar"
          }
        }
      }
    },
    "Your data": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din data"
          }
        }
      }
    },
    "Your data, explained": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din data, förklarad"
          }
        }
      }
    },
    "Your income": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din inkomst"
          }
        }
      }
    },
    "Your key": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nyckel"
          }
        }
      }
    },
    "Your own email address": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din egen e-postadress"
          }
        }
      }
    },
    "Your plan": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan"
          }
        }
      }
    },
    "Your rules": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina regler"
          }
        }
      }
    },
    "Your salary seems to land at the end of the month.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din lön verkar komma i slutet av månaden."
          }
        }
      }
    },
    "Your salary seems to land on the %@.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din lön verkar komma den %@."
          }
        }
      }
    },
