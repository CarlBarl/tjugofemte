        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportera CSV"
          }
        }
      }
    },
    "Fetching your transactions from the bank. The next screens fill themselves in from them.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar dina transaktioner från banken. Nästa steg fylls i utifrån dem."
          }
        }
      }
    },
    "Fewer categories": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färre kategorier"
          }
        }
      }
    },
    "First month it is due": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Första månaden den dras"
          }
        }
      }
    },
    "Found in your transactions. Switch off anything that is not income, and adjust the amounts.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittade i dina transaktioner. Slå av det som inte är inkomst och justera beloppen."
          }
        }
      }
    },
    "Gone when you say so": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Borta när du säger till"
          }
        }
      }
    },
