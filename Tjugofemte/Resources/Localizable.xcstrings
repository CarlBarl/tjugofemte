      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckel skapad inuti telefonen"
          }
        }
      }
    },
    "Keyword": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelord"
          }
        }
      }
    },
    "Keyword rules": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelordsregler"
          }
        }
      }
    },
    "Keyword, for example ica": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelord, till exempel ica"
          }
        }
      }
    },
    "Keywords match whole words, ignoring case. Your rules win over the built-in ones, newest first.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelord matchar hela ord oavsett stor eller liten bokstav. Dina regler går före de inbyggda, nyaste först."
          }
        }
      }
    },
    "Last day today": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sista dagen i dag"
          }
        }
      }
