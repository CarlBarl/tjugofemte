          "stringUnit": {
            "state": "translated",
            "value": "Lägg till regel"
          }
        }
      }
    },
    "After Register, the control panel shows your application with its ID in the heading, next to the name. Copy it and paste it here.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter Register visar kontrollpanelen din applikation med dess ID i rubriken, bredvid namnet. Kopiera det och klistra in här."
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alltid"
          }
        }
      }
    },
    "Always put %@ here": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg alltid %@ här"
