          "stringUnit": {
            "state": "translated",
            "value": "Dina regler"
          }
        }
      }
    },
    "Your transactions never leave this phone. Connecting takes about ten minutes the first time.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina transaktioner lämnar aldrig telefonen. Att ansluta tar ungefär tio minuter första gången."
          }
        }
      }
    },
    "per quarter": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "per kvartal"
          }
