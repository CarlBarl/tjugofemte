      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nöje"
          }
        }
      }
    },
    "Every transaction on this phone, for a spreadsheet.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje transaktion på den här telefonen, för ett kalkylark."
