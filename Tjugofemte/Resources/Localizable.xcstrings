    "Set aside %@ of %@ so far, paid %@ this quarter.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsatt %1$@ av %2$@ hittills, betalat %3$@ det här kvartalet."
          }
        }
      }
    },
    "Set aside for quarterly costs": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsatt för kvartalskostnader"
          }
        }
      }
