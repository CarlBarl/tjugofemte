    "Rent": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyra"
          }
        }
      }
    },
    "Reset this period's start": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ periodens start"
          }
        }
      }
