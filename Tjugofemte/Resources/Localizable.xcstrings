      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori"
          }
        }
      }
    },
    "Category budgets": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoribudgetar"
